{
  "name": "@nlbs/kaomoji",
  "version": "0.2.0",
  "packageManager": "pnpm@12.9.1",
  "description": "Minimalist kaomoji for Nanoo Labs documentation",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "engines": {
    "node": ">=20.10"
  },
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./kaomoji.json": "./kaomoji.json"
  },
  "files": [
    "dist",
    "kaomoji.json",
    "KAOMOJI.md",
    "LICENSE"
  ],
  "scripts": {
    "gen": "node gen.js",
    "build": "node gen.js && tsc",
    "dev": "tsc --watch",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "prepublishOnly": "pnpm build",
    "prepare": "husky"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nanoolabs/kaomoji.git"
  },
  "homepage": "https://github.com/nanoolabs/kaomoji#readme",
  "bugs": {
    "url": "https://github.com/nanoolabs/kaomoji/issues"
  },
  "keywords": [
    "nanoo",
    "kaomoji",
    "emoticon",
    "ascii",
    "minimalist",
    "documentation"
  ],
  "author": "Adnan Slamet Wibowo <adnan@nanoolabs.dev>",
  "license": "ISC",
  "lint-staged": {
    "*.{js,ts}": "eslint --fix"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@stylistic/eslint-plugin": "^5.10.0",
    "eslint": "^10.12.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.71.1"
  }
}
